PORT=3000
NODE_ENV=production

# PostgreSQL connection string from your cloud database provider:
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE
DATABASE_SSL=true

# Use a long random string in production.
SESSION_SECRET=replace-this-with-a-long-random-secret

# First administrator created automatically if users table is empty.
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@cadtel.local
ADMIN_PASSWORD=ChangeMeNow123!

# Set to 1 behind a reverse proxy / cloud platform.
TRUST_PROXY=1
