<%- include('partials/header') %>
<div class="card">
<h2>Recent Audit Logs</h2>
<div class="table-wrap"><table>
<thead><tr><th>Date/Time</th><th>User</th><th>Action</th><th>Entity</th><th>ID</th><th>Details</th><th>IP</th></tr></thead>
<tbody>
<% if(!logs.length){ %><tr><td colspan="7" class="empty">No audit records yet.</td></tr><% } %>
<% logs.forEach(l=>{ %><tr><td><%= new Date(l.created_at).toLocaleString() %></td><td><%= l.full_name||'System' %></td><td><%= l.action %></td><td><%= l.entity_type||'' %></td><td><%= l.entity_id||'' %></td><td><%= l.details||'' %></td><td><%= l.ip_address||'' %></td></tr><% }) %>
</tbody></table></div>
</div>
<%- include('partials/footer') %>