<%- include('partials/header') %>
<div class="card">
<h2>Post Payment</h2>
<form method="post" action="/payments/post" class="form-grid three">
<input type="hidden" name="csrf" value="<%= csrfToken %>">
<label class="span-2">Unpaid Invoice<select name="invoice_id" required><option value="">Select unpaid invoice</option>
<% openInvoices.forEach(i=>{ %><option value="<%= i.id %>"><%= i.invoice_no %> | <%= i.account_no %> - <%= i.full_name %> | Balance <%= peso(i.balance) %></option><% }) %>
</select></label>
<label>Amount<input type="number" step="0.01" min="0.01" name="amount" required></label>
<label>Payment Date<input type="date" name="payment_date" value="<%= new Date().toISOString().slice(0,10) %>" required></label>
<label>Method<select name="method"><option>Cash</option><option>GCash</option><option>Bank Transfer</option><option>Other</option></select></label>
<label>Reference No.<input name="reference_no"></label>
<label class="span-3">Notes<input name="notes"></label>
<div class="span-3 actions"><button class="btn primary">Post Payment</button></div>
</form>
</div>

<div class="card">
<h2>Recent Payments</h2>
<div class="table-wrap"><table>
<thead><tr><th>Date</th><th>Receipt</th><th>Invoice</th><th>Subscriber</th><th>Amount</th><th>Method</th><th>Reference</th><th>Received By</th><th></th></tr></thead>
<tbody>
<% if(!payments.length){ %><tr><td colspan="9" class="empty">No payments yet.</td></tr><% } %>
<% payments.forEach(p=>{ %><tr><td><%= String(p.payment_date).slice(0,10) %></td><td><%= p.receipt_no %></td><td><%= p.invoice_no %></td><td><%= p.account_no %> - <%= p.full_name %></td><td><%= peso(p.amount) %></td><td><%= p.method %></td><td><%= p.reference_no||'' %></td><td><%= p.receiver||'' %></td><td><a class="btn small" target="_blank" href="/payments/<%= p.id %>/receipt">Receipt</a></td></tr><% }) %>
</tbody></table></div>
</div>
<%- include('partials/footer') %>