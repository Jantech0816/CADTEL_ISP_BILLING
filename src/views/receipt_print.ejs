<!doctype html>
<html><head><meta charset="utf-8"><title><%= payment.receipt_no %></title><link rel="stylesheet" href="/style.css"></head>
<body class="print-page">
<div class="receipt printable">
<div class="receipt-head"><h1>CADTEL DATA NETSERV</h1><p>Official Payment Receipt</p></div><hr>
<div class="receipt-row"><b>Receipt No.</b><span><%= payment.receipt_no %></span></div>
<div class="receipt-row"><b>Date</b><span><%= String(payment.payment_date).slice(0,10) %></span></div>
<div class="receipt-row"><b>Subscriber</b><span><%= payment.full_name %></span></div>
<div class="receipt-row"><b>Account No.</b><span><%= payment.account_no %></span></div>
<div class="receipt-row"><b>Invoice</b><span><%= payment.invoice_no %></span></div><hr>
<div class="receipt-row"><b>Amount Paid</b><b><%= peso(payment.amount) %></b></div>
<div class="receipt-row"><span>Method</span><span><%= payment.method %></span></div>
<div class="receipt-row"><span>Reference</span><span><%= payment.reference_no || '-' %></span></div>
<div class="receipt-row"><span>Received By</span><span><%= payment.receiver || '' %></span></div><hr>
<p class="center">Payment received. Thank you!</p>
<div class="no-print actions"><button class="btn primary" onclick="window.print()">Print</button></div>
</div></body></html>